# Paxofi Corporate Website API — production settings.
# Save as .env in this folder (paxofi-api-runtime/backend/.env), permissions 600.
# This file sits outside the public document root (backend/public), so it is
# never served to visitors. Never upload it to Git.

APP_ENV=production
APP_DEBUG=false

# cPanel → MySQL Databases (database and user names are prefixed with your account, e.g. paxoalhu_).
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=paxoalhu_corporate
DB_USERNAME=paxoalhu_change_me
# Wrap the password in double quotes if it contains #, spaces or quotes.
DB_PASSWORD="change-me"

# Exact website address(es) allowed to send the contact form, comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://corporate.paxofi.com

# Contact form abuse limits (per IP address and per email address).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10

# Staff admin area (Phase 2, decision D-009): one-time code for creating the FIRST administrator
# at https://corporate.paxofi.com/admin/setup. Use 32+ random characters, e.g. from a password
# manager. It only works while no staff account exists. Delete this line after setup.
# ADMIN_SETUP_TOKEN=

# Two-factor sign-in (Phase 2, decision D-010): key that encrypts the authenticator secrets.
# 32+ random letters and numbers (no spaces, # or quotes). Set it ONCE and keep it: changing
# or losing it means staff sign in with a recovery code and set up their authenticator again.
# While it is missing, two-factor sign-in is unavailable and not enforced.
# MFA_ENCRYPTION_KEY=

# Media library (Phase 2, decision D-012): the folder where uploaded pictures and documents are
# kept. Create it ONCE in File Manager, OUTSIDE paxofi-api-runtime and public_html (a new release
# replaces paxofi-api-runtime), e.g. /home/paxoalhu/paxofi-media. While unset, uploads are off.
# MEDIA_STORAGE_PATH=/home/paxoalhu/paxofi-media

# Email (Phase 2, decision D-016): new-enquiry alerts, staff password reset links and error alerts
# are sent through a company mailbox. cPanel → Email Accounts → Connect Devices shows the outgoing
# server and SSL port. While MAIL_TRANSPORT is unset, no email is sent and nothing else changes.
# MAIL_TRANSPORT=smtp
# MAIL_HOST=mail.paxofi.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=no-reply@paxofi.com
# MAIL_PASSWORD="change-me"
# MAIL_FROM_ADDRESS=no-reply@paxofi.com
# MAIL_FROM_NAME="Paxofi Technologies"
# Who is told about new enquiries and about errors (comma-separated).
# ENQUIRY_ALERT_TO=hello@paxofi.com
# ERROR_ALERT_TO=it@paxofi.com
# Address of the website used in email links (defaults to the first CORS origin).
# STAFF_AREA_URL=https://corporate.paxofi.com

# Nightly backups (D-016, bin/backup.php): a folder OUTSIDE the website folders, and how many days to keep.
# BACKUP_PATH=/home/paxoalhu/paxofi-backups
# BACKUP_KEEP_DAYS=14

# careers.paxofi.com (D-018, D-019): who is told about new applications (comma-separated), where
# candidates' replies go, and the careers site address used in emails. Add https://careers.paxofi.com
# to CORS_ALLOWED_ORIGINS too. CVs are kept in MEDIA_STORAGE_PATH/applications (never public).
# RECRUITMENT_ALERT_TO=hr@paxofi.com
# RECRUITMENT_REPLY_TO=hr@paxofi.com
# CAREERS_SITE_URL=https://careers.paxofi.com
