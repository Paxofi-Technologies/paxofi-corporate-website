# Copy to a local environment file; never commit real secrets.
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paxofi_corporate_website
DB_USERNAME=change-me
DB_PASSWORD=change-me

# Redis (optional by deployment profile)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API
API_BASE_URL=http://localhost/api/v1
