# Copy to backend/.env (outside the public document root) or set as real
# environment variables. Real environment variables take precedence.
# Never commit real secrets.

# One of: development, testing, staging, production
APP_ENV=development
# Ignored in production (debug output is never enabled there).
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=paxofi_corporate_website
DB_USERNAME=change-me
DB_PASSWORD=change-me

# Comma-separated exact origins allowed to call the API from a browser.
# Production example: https://paxofi.com,https://www.paxofi.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Contact form abuse controls (per IP address and per email address).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10

# Redis (optional by deployment profile)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Frontend (build-time)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API base URL; the contact form posts to {NEXT_PUBLIC_API_URL}/forms/contact/submit
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
